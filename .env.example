SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=videotrace
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=videotrace
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/videotrace?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=videotrace
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
# 部分站点（如 B 站）缺少登录态会返回 HTTP 412，需要提供 cookie 才能下载在线视频链接。
# 二者互斥，YTDLP_COOKIES 优先；留空则不带 cookie（仅支持无需登录的站点）。
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
# URL import is disabled unless a controlled HTTP proxy is configured (http://host:port).
# Proxy must block internal/reserved destinations; restrict downloader egress to the proxy.
YTDLP_PROXY=
FFMPEG_DIR=
OCR_COMMAND=tesseract
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# VideoTrace worker resource limits (same rate configuration across workers)
VIDEO_PARSE_VERSION=v1
ANALYSIS_CONSUMER_MIN=2
ANALYSIS_CONSUMER_MAX=4
ANALYSIS_DEFER_SECONDS=30
MEDIA_PROCESS_CONCURRENT=2
ASR_CALL_CONCURRENT=4
ASR_CALLS_PER_MINUTE=60
LLM_CALL_CONCURRENT=4
LLM_CALLS_PER_MINUTE=30
EMBEDDING_CALL_CONCURRENT=4
EMBEDDING_CALLS_PER_MINUTE=120

# Creator: run one process with creator/.venv/Scripts/python -m uvicorn creator.app:app --host 127.0.0.1 --port 8091 --env-file .env
# Install the isolated environment from creator/requirements-lock.txt. Blank token disables internal access.
CREATOR_ENABLED=true
CREATOR_URL=http://127.0.0.1:8091
CREATOR_JAVA_URL=http://127.0.0.1:9090
CREATOR_INTERNAL_TOKEN=
CREATOR_DATA_DIR=creator/data
CREATOR_DISPATCH_DELAY_MS=5000
CREATOR_MODEL_TIMEOUT_SECONDS=240
CREATOR_RENDER_TIMEOUT_SECONDS=600
# Leave model overrides unset to reuse SILICONFLOW_* and LLM_MODEL.
# CREATOR_LLM_BASE_URL=https://api.siliconflow.cn/v1
# CREATOR_LLM_API_KEY=
# CREATOR_LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# Any OpenAI-compatible Chat Completions endpoint with tool calling is supported.
# Restart the Python creator service after changing model settings.
# Optional JSON request parameters; null removes a default parameter.
# Example: remove temperature/max_tokens and use max_completion_tokens instead.
# CREATOR_LLM_OPTIONS={"temperature":null,"max_tokens":null,"max_completion_tokens":5000}
# DeepSeek defaults to thinking disabled; other providers receive no DeepSeek fields.
# Use non-thinking mode: this workflow does not retain reasoning_content between calls.
# CREATOR_LLM_OPTIONS={"thinking":{"type":"disabled"}}
# Required on Linux if no Noto Sans CJK is installed; Windows auto-detects Microsoft YaHei.
CREATOR_FONT_PATH=
# Separate account limited to GetObject/PutObject under media/creations/*; do not use administrator credentials.
CREATOR_MINIO_ENDPOINT=http://localhost:9000
CREATOR_MINIO_BUCKET=media
CREATOR_MINIO_ACCESS_KEY=
CREATOR_MINIO_SECRET_KEY=
